<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>simple-architecture-mcp</AssemblyName>
    <RootNamespace>SimpleArchitectureMcp.Server</RootNamespace>
    <UserSecretsId>devtools-mcp-6c1f0c1e</UserSecretsId>

    <!-- Native AOT, single file, self-contained -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- Source-generate minimal API endpoints even when PublishAot is off. The SDK only turns the
         Request Delegate Generator on together with PublishAot, so a -p:PublishAot=false publish would
         fall back to the reflection-based MapGet/MapPost overloads and fail on IL2026/IL3050. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- Lean binary -->
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>

    <!-- AOT/trim warnings are errors so regressions fail the build -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050;IL3051</WarningsAsErrors>
    <!-- The MCP Skills extension is experimental in the SDK (ModelContextProtocol.Extensions.Skills). -->
    <NoWarn>$(NoWarn);MCPEXP005</NoWarn>
  </PropertyGroup>

  <!-- Fallback when the native toolchain is missing (e.g. Windows without the "Desktop development with C++"
       workload): publish with -p:PublishAot=false to get a trimmed, self-contained single-file executable
       running on the regular JIT runtime instead. -->
  <PropertyGroup Condition="'$(PublishAot)' != 'true'">
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <!-- osx-x64: Xcode 15/16's ld_classic (the SDK default there) rejects unaligned pointers in
       libSystem.Net.Security.Native.a; the new Apple linker only warns. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
    <UseLdClassicXCodeLinker>false</UseLdClassicXCodeLinker>
  </PropertyGroup>

  <!-- Workflow skills served over MCP (Core/Skills/ModuleSkills): skills/<name>/<path> inside the single-file binary. -->
  <ItemGroup>
    <EmbeddedResource Include="Skills\**\*" LogicalName="skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleArchitectureMcp.Tests" />
    <InternalsVisibleTo Include="SimpleArchitectureMcp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Extensions.Skills" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

</Project>
